APP_NAME="Laravel AI Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_ai_gateway
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_PROVIDER=openai
AI_RATE_LIMIT_PER_MINUTE=30
AI_RETRY_ATTEMPTS=3
AI_RETRY_BASE_SLEEP_MS=100
AI_RETRY_MAX_SLEEP_MS=2000

AI_USAGE_ENABLED=true
AI_USAGE_WINDOW_MINUTES=10
AI_USAGE_MAX_REQUESTS=30
AI_USAGE_COOLDOWN_MINUTES=5

AI_CONTEXT_HISTORY_LIMIT=20
AI_CONTEXT_MEMORY_LIMIT=5
AI_MEMORY_MAX_PER_USER=50

AI_DEFAULT_PROMPT=

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROTOCOL=chat_completions
OPENAI_TIMEOUT=30

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PROTOCOL=generate_content
GEMINI_TIMEOUT=30

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PROTOCOL=chat_completions
OPENROUTER_REFERER=
OPENROUTER_TITLE=
OPENROUTER_TIMEOUT=30

OPENCODE_API_KEY=
OPENCODE_MODEL=muse-spark-1.3-contributor-free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_PROTOCOL=responses
OPENCODE_TIMEOUT=30

GLM_API_KEY=
GLM_MODEL=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_PROTOCOL=chat_completions
GLM_TIMEOUT=30

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PROTOCOL=chat_completions
DEEPSEEK_TIMEOUT=30
